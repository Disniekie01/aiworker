{
  "scene_entry": "newscene.usda",
  "description": "Self-contained pick/place Isaac scene. Assets ship in git via Git LFS — run git lfs pull after clone.",
  "required_paths": [
    "Scene.usda",
    "assets/environment/Austria/SceneRobot.usd",
    "assets/crate/KB3D_CTS_Crate_A.fbx",
    "assets/shirt/scene.usdc"
  ],
  "optional_paths": [
    "assets/crate/KB3D_CTS_Crate_A.mtl",
    "assets/shirt/0/Material_baseColor.jpg"
  ],
  "maintainer_rebuild_env": {
    "NEWSCENE_ROBOT_USD": "Path to FFW SG2 Scene.usda",
    "NEWSCENE_AUSTRIA_DIR": "Directory containing SceneRobot.usd",
    "NEWSCENE_CRATE_FBX": "KB3D crate FBX",
    "NEWSCENE_SHIRT_USDZ_DIR": "Extracted USDZ folder with scene.usdc"
  },
  "maintainer_script": "./collect_assets.sh copy"
}
